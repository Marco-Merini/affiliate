{
  "type": "object",
  "name": "Product",
  "description": "Produto de terceiros divulgado pelo afiliado. O pre\u00e7o cadastrado \u00e9 uma refer\u00eancia e n\u00e3o \u00e9 atualizado automaticamente.",
  "properties": {
    "name": {
      "type": "string",
      "description": "Nome do produto"
    },
    "description": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o do produto"
    },
    "type": {
      "type": "string",
      "enum": [
        "physical",
        "digital"
      ],
      "enumColors": [
        "blue",
        "purple"
      ],
      "description": "Produto f\u00edsico ou digital"
    },
    "category_id": {
      "type": "string",
      "description": "Refer\u00eancia \u00e0 categoria"
    },
    "image_url": {
      "type": "string",
      "description": "Imagem principal do produto"
    },
    "current_price": {
      "type": "number",
      "description": "Pre\u00e7o atual de refer\u00eancia em BRL"
    },
    "previous_price": {
      "type": "number",
      "description": "Pre\u00e7o anterior de refer\u00eancia em BRL"
    },
    "program_id": {
      "type": "string",
      "description": "Refer\u00eancia ao programa de afiliados"
    },
    "affiliate_url": {
      "type": "string",
      "description": "Link de afiliado principal"
    },
    "commission_percent": {
      "type": "number",
      "description": "Percentual estimado de comiss\u00e3o"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "paused",
        "archived"
      ],
      "enumColors": [
        "green",
        "yellow",
        "gray"
      ],
      "description": "Situa\u00e7\u00e3o do produto no cat\u00e1logo"
    },
    "price_checked_at": {
      "type": "string",
      "format": "date-time",
      "description": "Data da \u00faltima verifica\u00e7\u00e3o manual de pre\u00e7o"
    },
    "notes": {
      "type": "string",
      "description": "Observa\u00e7\u00f5es internas"
    }
  },
  "required": [
    "name",
    "type",
    "status"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}