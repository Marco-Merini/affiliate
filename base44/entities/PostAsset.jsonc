{
  "type": "object",
  "name": "PostAsset",
  "description": "Imagens de uma publica\u00e7\u00e3o, incluindo os slides de um carrossel.",
  "properties": {
    "post_id": {
      "type": "string",
      "description": "Publica\u00e7\u00e3o dona do arquivo"
    },
    "file_uri": {
      "type": "string",
      "description": "URI privada do arquivo enviado"
    },
    "position": {
      "type": "number",
      "description": "Ordem no carrossel (come\u00e7a em 0)"
    },
    "caption": {
      "type": "string",
      "description": "Texto do slide"
    },
    "media_type": {
      "type": "string",
      "enum": [
        "image"
      ],
      "enumColors": [
        "blue"
      ],
      "description": "Tipo de m\u00eddia (apenas imagens no MVP)"
    }
  },
  "required": [
    "post_id",
    "file_uri"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}