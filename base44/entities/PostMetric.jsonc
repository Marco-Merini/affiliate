{
  "type": "object",
  "name": "PostMetric",
  "description": "M\u00e9tricas devolvidas pelas pr\u00f3prias plataformas. Nunca representa vendas.",
  "properties": {
    "post_id": {
      "type": "string",
      "description": "Publica\u00e7\u00e3o medida"
    },
    "platform": {
      "type": "string",
      "enum": [
        "instagram",
        "facebook",
        "tiktok",
        "pinterest"
      ],
      "enumColors": [
        "pink",
        "blue",
        "gray",
        "red"
      ],
      "description": "Plataforma de origem da m\u00e9trica"
    },
    "impressions": {
      "type": "number",
      "description": "Impress\u00f5es informadas"
    },
    "reach": {
      "type": "number",
      "description": "Alcance informado"
    },
    "likes": {
      "type": "number",
      "description": "Curtidas"
    },
    "comments": {
      "type": "number",
      "description": "Coment\u00e1rios"
    },
    "shares": {
      "type": "number",
      "description": "Compartilhamentos"
    },
    "saves": {
      "type": "number",
      "description": "Salvamentos"
    },
    "collected_at": {
      "type": "string",
      "format": "date-time",
      "description": "Momento da coleta"
    }
  },
  "required": [
    "post_id",
    "platform"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}