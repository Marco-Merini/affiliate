{
  "name": "Atualizar vitrine do Mercado Livre",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "interval",
      "cron_expression": null,
      "one_time_date": null,
      "timezone": "America/Sao_Paulo",
      "interval_value": 5,
      "interval_unit": "minutes",
      "interval_anchor": "2026-11-24T23:50:00Z",
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "description": "L\u00ea a lista de afiliados do Mercado Livre e atualiza pre\u00e7os, avalia\u00e7\u00f5es e novos produtos da vitrine a cada 5 minutos.",
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "atualizar_vitrine_mercado_livre",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "sincronizar_ofertas": {
          "call": "invoke_server_route",
          "with": {
            "path": "/api/sync/ofertas",
            "method": "POST"
          },
          "then": "end",
          "x-base44": {
            "title": "Sincronizar ofertas",
            "description": "Pre\u00e7os, avalia\u00e7\u00f5es e produtos novos da lista"
          }
        }
      }
    ]
  }
}