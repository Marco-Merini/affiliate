{
  "type": "object",
  "name": "AffiliateProgram",
  "description": "Programa de afiliados de terceiros (marketplace ou plataforma de produtor).",
  "properties": {
    "name": {
      "type": "string",
      "description": "Nome do programa, ex.: Amazon Associados"
    },
    "platform": {
      "type": "string",
      "enum": [
        "mercado_livre",
        "amazon",
        "shopee",
        "hotmart",
        "outro"
      ],
      "enumColors": [
        "yellow",
        "blue",
        "red",
        "purple",
        "gray"
      ],
      "description": "Marketplace ou plataforma de origem"
    },
    "website_url": {
      "type": "string",
      "description": "Site oficial do programa"
    },
    "default_commission": {
      "type": "number",
      "description": "Percentual de comiss\u00e3o estimado por padr\u00e3o"
    },
    "notes": {
      "type": "string",
      "description": "Observa\u00e7\u00f5es operacionais"
    },
    "is_active": {
      "type": "boolean",
      "description": "Programa dispon\u00edvel para novos produtos"
    }
  },
  "required": [
    "name",
    "platform"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}