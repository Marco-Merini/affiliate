{
  "type": "object",
  "name": "ClickEvent",
  "description": "Clique em um link de afiliado rastreado pelo pr\u00f3prio sistema. Clique n\u00e3o \u00e9 venda.",
  "properties": {
    "affiliate_link_id": {
      "type": "string",
      "description": "Link clicado"
    },
    "product_id": {
      "type": "string",
      "description": "Produto relacionado"
    },
    "post_id": {
      "type": "string",
      "description": "Publica\u00e7\u00e3o de origem, quando houver"
    },
    "platform": {
      "type": "string",
      "enum": [
        "instagram",
        "facebook",
        "tiktok",
        "pinterest",
        "direto"
      ],
      "enumColors": [
        "pink",
        "blue",
        "gray",
        "red",
        "purple"
      ],
      "description": "Canal de origem do clique"
    },
    "referrer": {
      "type": "string",
      "description": "Origem informada pelo navegador"
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time",
      "description": "Momento do clique"
    }
  },
  "required": [
    "affiliate_link_id"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}