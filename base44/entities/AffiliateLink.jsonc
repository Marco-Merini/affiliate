{
  "type": "object",
  "name": "AffiliateLink",
  "description": "Links de afiliado de um produto. Um produto pode ter v\u00e1rios links (por programa ou por canal).",
  "properties": {
    "product_id": {
      "type": "string",
      "description": "Produto ao qual o link pertence"
    },
    "program_id": {
      "type": "string",
      "description": "Programa de afiliados do link"
    },
    "url": {
      "type": "string",
      "description": "Link exclusivo de afiliado"
    },
    "label": {
      "type": "string",
      "description": "Identifica\u00e7\u00e3o do link, ex.: Bio do Instagram"
    },
    "is_primary": {
      "type": "boolean",
      "description": "Link padr\u00e3o do produto"
    },
    "is_active": {
      "type": "boolean",
      "description": "Link em uso"
    }
  },
  "required": [
    "product_id",
    "url"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}