{
  "type": "object",
  "name": "Category",
  "description": "Categoria usada para organizar e filtrar produtos na vitrine p\u00fablica.",
  "properties": {
    "name": {
      "type": "string",
      "description": "Nome da categoria"
    },
    "slug": {
      "type": "string",
      "description": "Identificador amig\u00e1vel usado na URL p\u00fablica"
    },
    "description": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o curta"
    },
    "image_url": {
      "type": "string",
      "description": "Imagem de destaque da categoria"
    },
    "is_featured": {
      "type": "boolean",
      "description": "Categoria destacada na p\u00e1gina inicial"
    },
    "is_active": {
      "type": "boolean",
      "description": "Categoria dispon\u00edvel para novos produtos e vis\u00edvel na vitrine"
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}